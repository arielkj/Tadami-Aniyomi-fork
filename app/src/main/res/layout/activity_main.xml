<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/map_bg">

    <com.mapbox.mapboxsdk.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Columna izquierda: busqueda, velocidad, panel de guia -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <!-- Busqueda: ARRIBA de la velocidad (mockup v2) -->
        <FrameLayout
            android:layout_width="340dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_panel"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="32dp"
                android:background="@android:color/transparent"
                android:hint="@string/search_hint"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="17sp"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text" />
        </FrameLayout>

        <!-- Velocidad -->
        <TextView
            android:id="@+id/speedValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0"
            android:textColor="@color/text_primary"
            android:textSize="64sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-10dp"
            android:text="@string/mph"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <!-- Panel de guia: compacto en recto, crece cerca del giro -->
        <LinearLayout
            android:id="@+id/guidanceCard"
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_panel"
            android:orientation="horizontal"
            android:padding="14dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/maneuverArrow"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_arrow_up" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/maneuverTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/maneuverStreet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/maneuverEta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Resultados de busqueda / guardados -->
        <ListView
            android:id="@+id/searchResults"
            android:layout_width="340dp"
            android:layout_height="300dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_panel"
            android:divider="@color/panel_border"
            android:dividerHeight="1dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Controles derecha: brujula, dia/noche, zoom -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btnCompass"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="Norte o hacia donde voy"
            android:padding="14dp"
            android:src="@drawable/ic_compass" />

        <ImageButton
            android:id="@+id/btnDayNight"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="Dia o noche"
            android:padding="14dp"
            android:src="@drawable/ic_night" />

        <ImageButton
            android:id="@+id/btnZoomIn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="Acercar"
            android:padding="14dp"
            android:src="@drawable/ic_plus" />

        <ImageButton
            android:id="@+id/btnZoomOut"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="Alejar"
            android:padding="14dp"
            android:src="@drawable/ic_minus" />
    </LinearLayout>

    <!-- Tarjeta de punto (long-press): ir o guardar -->
    <LinearLayout
        android:id="@+id/pointCard"
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="76dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/pointTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pointSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnGo"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_panel"
                android:gravity="center"
                android:text="@string/go"
                android:textColor="@color/accent_blue"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSavePoint"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_panel"
                android:gravity="center"
                android:text="@string/save"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Barra inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:background="@drawable/bg_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_star" />

        <TextView
            android:id="@+id/btnSaved"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="@string/saved_places"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/offline_status"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnCancelRoute"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="@string/cancel_route"
            android:textColor="@color/accent_blue"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
